[Unit]
Description=Legal Department FastAPI
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/legal-dep
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/legal-dep/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
